diff --git a/xiaohongshu/feed_fallback.go b/xiaohongshu/feed_fallback.go
index c5d4295..84732a2 100644
--- a/xiaohongshu/feed_fallback.go
+++ b/xiaohongshu/feed_fallback.go
@@ -50,10 +50,13 @@ func diagnoseFeedPage(page *rod.Page, operation string) error {
 func classifyFeedPage(d pageDiagnosis) string {
 	text := strings.ToLower(d.URL + " " + d.Title + " " + d.Body)
 	switch {
+	// Captcha URLs include "web-site-login". Check verification/risk markers
+	// before generic login text so an already logged-in account is not reported
+	// as having lost its session.
+	case strings.Contains(text, "captcha") || strings.Contains(text, "verify") || strings.Contains(text, "验证") || strings.Contains(text, "安全") || strings.Contains(text, "异常") || strings.Contains(text, "访问频繁"):
+		return "RISK_CONTROL"
 	case strings.Contains(text, "登录") || strings.Contains(text, "login") || strings.Contains(text, "扫码"):
 		return "LOGIN_REQUIRED"
-	case strings.Contains(text, "验证") || strings.Contains(text, "captcha") || strings.Contains(text, "安全") || strings.Contains(text, "异常") || strings.Contains(text, "访问频繁"):
-		return "RISK_CONTROL"
 	case strings.Contains(text, "暂无内容") || strings.Contains(text, "没有找到") || strings.Contains(text, "无结果"):
 		return "EMPTY_RESULT"
